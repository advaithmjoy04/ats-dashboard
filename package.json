{
  "name": "ats-backend",
  "version": "0.1.0",
  "description": "Production ready ATS backend.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/kill-ports.js && concurrently \"nodemon server.js\" \"npm run dev --prefix client\"",
    "dev:server": "nodemon server.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "test": "jest --runInBand",
    "test:security": "jest --runInBand tests",
    "verify:job-flow": "node scripts/verify-job-flow.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:platform-admin": "node scripts/seed-platform-admin.js",
    "seed:tenant": "node scripts/seed-default-tenant.js",
    "backfill:tenant": "node scripts/backfill-tenant-id.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.3.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mammoth": "^1.12.0",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.4",
    "pdf-parse": "^2.4.5",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "@xmldom/xmldom": "^0.8.12",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.0.1"
    ,
    "supertest": "^7.1.1"
  }
}
